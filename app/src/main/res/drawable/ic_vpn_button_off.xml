<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#990000" />
            <size android:width="200dp" android:height="200dp" />
        </shape>
    </item>
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#FF4444"
                android:endColor="#CC0000"
                android:angle="270" />
            <size android:width="196dp" android:height="196dp" />
        </shape>
    </item>
    <item android:top="6dp" android:left="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#FF6666"
                android:endColor="#FF4444"
                android:angle="270" />
        </shape>
    </item>
</layer-list>
